PORT=4000
DB_FILE=./data/store.sqlite

# Origins allowed to call the API with cookies, comma separated. Add your LAN address here
# when testing from a phone, e.g. http://192.168.1.5:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Local development only: when set, one account per role is created on startup with this password
# (customer@, sales@, product@ and support@orbit.test). Leave empty to create none.
DEMO_USERS_PASSWORD=
